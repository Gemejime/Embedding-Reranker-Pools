# ==============================================================================
# RAG Inference Serving (rag-inference-serving)
# Environment Configuration Template (.env.example)
#
# Hardware-Accelerated Embedding & Reranker Pools for Enterprise RAG Serving.
# Copy this file to '.env' and adjust the values according to your target pool and environment.
# All RAG_SERVING_* variables directly configure internal/config/settings.py (ServingSettings).
#
# IMPORTANT ARCHITECTURAL NOTE ON DEPLOYMENTS:
# Changes in '.env' ONLY affect local runs/testing and DO NOT propagate to deployments.
# ONLY changes in '.env.prod' affect Kubernetes & Helm manifests in 'deployments/'
# (synchronized via scripts/sync_env_to_deployments.py and enforced by pre-commit hooks).
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Service Identity & Hardware Compute Pool Topology
# ------------------------------------------------------------------------------
# Target compute pool defining queue delay, batch ceilings, and expected model engines.
# Options:
#   - online_embedding: Dedicated On-Demand NVIDIA L4/A10G (<= 2ms delay, max batch 32, P99 <= 10ms)
#   - online_reranker:  Dedicated On-Demand NVIDIA L4/A10G (<= 4ms delay, max batch 32, P99 <= 30ms)
#   - batch_ingestion:  Preemptible Spot GPU Nodes (<= 50ms delay, max batch 256, 2500-3500 chunks/s)
RAG_SERVING_POOL_TYPE=online_embedding

# ------------------------------------------------------------------------------
# 2. Out-of-Band Operational Server (ASGI FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Host interface to bind internal ASGI Doc API / probe server (0.0.0.0 for containerized pods)
RAG_SERVING_SERVER_HOST=0.0.0.0

# HTTP port for FastAPI ASGI server hosting /healthz, /ready, /metrics, and Doc API (/docs, /redoc, /api/docs, /openapi.json)
RAG_SERVING_SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 3. NVIDIA Triton Inference Server KServe v2 Endpoints
# ------------------------------------------------------------------------------
# Internal HTTP URL for Triton KServe v2 server health and readiness probes (pod-local loopback)
RAG_SERVING_TRITON_HTTP_URL=http://127.0.0.1:8000

# Default internal gRPC endpoint for Triton KServe v2 binary tensor inference (pod-local loopback)
RAG_SERVING_TRITON_GRPC_URL=127.0.0.1:8001

# ------------------------------------------------------------------------------
# 4. Decoupled Compute Pool gRPC Service Targets (Orchestrator Channel Pool)
# ------------------------------------------------------------------------------
# Dedicated service endpoints per decoupled compute pool using gRPC DNS resolver (dns:///)
# for client-side round-robin load balancing across headless Kubernetes pod replicas.
# gRPC service endpoint for Online Embedding Pool (Pool A: Dedicated On-Demand L4/A10G)
RAG_SERVING_ONLINE_EMBED_GRPC_URL=dns:///rag-inference-online-embedding.rag-inference-serving.svc.cluster.local:8001

# gRPC service endpoint for Online Reranker Pool (Pool B: Dedicated On-Demand L4/A10G)
RAG_SERVING_ONLINE_RERANK_GRPC_URL=dns:///rag-inference-online-reranker.rag-inference-serving.svc.cluster.local:8001

# gRPC service endpoint for Batch Ingestion Pool (Preemptible Spot Nodes)
RAG_SERVING_BATCH_INGEST_GRPC_URL=dns:///rag-inference-batch-ingestion.rag-inference-serving.svc.cluster.local:8001

# ------------------------------------------------------------------------------
# 5. Dynamic Batching & Queue Latency Ceilings (Calibrated Invariants)
# ------------------------------------------------------------------------------
# Native Triton dynamic batch queue delay timeout in microseconds (max_queue_delay_microseconds).
# Calibrated ceilings:
#   - online_embedding: 2000  (<= 2 ms)
#   - online_reranker:  4000  (<= 4 ms)
#   - batch_ingestion:  50000 (<= 50 ms)
RAG_SERVING_MAX_QUEUE_DELAY_MICROSECONDS=2000

# Maximum dynamic batch size permitted for this compute pool (max_batch_size).
# Calibrated ceilings:
#   - online_embedding: 32
#   - online_reranker:  32
#   - batch_ingestion:  256
RAG_SERVING_MAX_BATCH_SIZE=32

# ------------------------------------------------------------------------------
# 6. VRAM Headroom Guards & Operational Ceilings (ADR / Memory Safety)
# ------------------------------------------------------------------------------
# Total GPU VRAM capacity in bytes (Default: 24 GiB = 25,769,803,776 bytes for NVIDIA L4/A10G)
RAG_SERVING_VRAM_CAPACITY_BYTES=25769803776

# Ceiling for aggregate static model allocations in bytes (<= 20 GiB = 21,474,836,480 bytes, ~83.33%)
# Reserves dedicated >= 4 GiB dynamic activation headroom
RAG_SERVING_MAX_STATIC_VRAM_BYTES=21474836480

# Active runtime VRAM utilization ratio ceiling triggering HTTP 503 traffic shedding (Default: 0.85 = 85%)
# If active memory exceeds 85% (> 20.4 GiB), /ready probe returns 503 to prevent CUDA OOM
RAG_SERVING_VRAM_MAX_UTILIZATION_RATIO=0.85

# ------------------------------------------------------------------------------
# 7. Expected Model Engines Configuration (Readiness Verification)
# ------------------------------------------------------------------------------
# JSON-encoded array of model engine names expected in Triton repository for /ready probe check.
# Pool defaults:
#   - online_embedding: ["online_embedder_ensemble", "dense_embedder_trt", "text_tokenizer"]
#   - online_reranker:  ["online_reranker_ensemble", "cross_encoder_trt", "text_tokenizer"]
#   - batch_ingestion:  ["batch_embedder_ensemble", "dense_embedder_trt", "text_tokenizer"]
RAG_SERVING_MODELS_EXPECTED=["online_embedder_ensemble","dense_embedder_trt","text_tokenizer"]

# ------------------------------------------------------------------------------
# 8. POSIX Shared Memory IPC (/dev/shm) Configuration
# ------------------------------------------------------------------------------
# Base path for pod-scoped POSIX shared memory emptyDir volume (strictly co-located containers)
RAG_SERVING_SHM_BASE_PATH=/dev/shm

# ------------------------------------------------------------------------------
# 9. gRPC Transport Security & Mutual TLS (mTLS) Encryption
# ------------------------------------------------------------------------------
# Enable TLS encryption for inter-pod gRPC inference client channels (true / false)
RAG_SERVING_GRPC_TLS_ENABLED=false

# Filesystem path to root CA certificate verifying Triton server TLS certificates
# Mount via Kubernetes Secret volume (e.g., /etc/ssl/certs/rag-ca.crt)
RAG_SERVING_GRPC_CA_CERT_PATH=

# Filesystem path to client public certificate for mutual TLS (mTLS) authentication
RAG_SERVING_GRPC_CLIENT_CERT_PATH=

# Filesystem path to client private key for mutual TLS (mTLS) authentication
RAG_SERVING_GRPC_CLIENT_KEY_PATH=

# Optional SNI hostname override for TLS certificate validation (e.g. triton.rag.internal)
RAG_SERVING_GRPC_SERVER_NAME_OVERRIDE=

# ------------------------------------------------------------------------------
# 10. Operational Server Security & Administrative Access Control
# ------------------------------------------------------------------------------
# Optional bearer API token for securing operational endpoints (/metrics)
# When set, callers must provide 'Authorization: Bearer <token>' or 'x-api-key: <token>'
RAG_SERVING_API_KEY=

# Structured logging verbosity level: DEBUG, INFO, WARNING, ERROR
RAG_SERVING_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 11. KEDA Autoscaling Triggers & Telemetry Secrets (Prometheus & Kafka Auth)
# ------------------------------------------------------------------------------
# Prometheus server address for KEDA triton_queue_duration_microseconds autoscaling trigger
PROMETHEUS_SERVER_ADDRESS=http://prometheus-k8s.monitoring.svc:9090

# Optional Bearer token for authenticating KEDA triggers against secured Prometheus
PROMETHEUS_BEARER_TOKEN=

# Kafka broker bootstrap servers for Batch Ingestion backlog autoscaling trigger
KAFKA_BOOTSTRAP_SERVERS=kafka.event-streaming.svc:9092

# Kafka consumer group name monitored by KEDA ScaledObject
KAFKA_CONSUMER_GROUP=rag-batch-embedder-group

# Kafka ingestion topic name
KAFKA_TOPIC=rag.ingestion.chunks

# Kafka SASL credentials for KEDA TriggerAuthentication
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/kafka-ca.crt

# ------------------------------------------------------------------------------
# 12. Model Weight Storage, PVC Hydration & Cloud Registry Credentials
# ------------------------------------------------------------------------------
# Hugging Face API token for downloading gated/private weights during export (export_onnx.py)
HF_TOKEN=

# AWS / S3 / MinIO / Ceph credentials for pulling serialized TensorRT engines (model.plan)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Custom S3 endpoint URL for on-premise or cloud-native object storage (e.g., MinIO)
AWS_ENDPOINT_URL=

# S3 or OCI artifact storage URI containing precompiled TensorRT model engines
MODEL_REGISTRY_STORAGE_URI=s3://rag-model-cache/tensorrt-engines/

# ------------------------------------------------------------------------------
# 13. Triton Process Supervisor & Container Runtime Environment
# ------------------------------------------------------------------------------
# Model repository directory path containing Triton model directory structure
MODEL_REPOSITORY=/models

# Command-line arguments passed to tritonserver process supervisor in entrypoint.sh
TRITON_ARGS="--model-repository=/models --strict-model-config=true --log-verbose=0"

# Python standard I/O unbuffered output (ensures immediate structured log flushing)
PYTHONUNBUFFERED=1

# Disable Python bytecode compilation (.pyc generation in container environments)
PYTHONDONTWRITEBYTECODE=1

# ------------------------------------------------------------------------------
# 14. Benchmark & Chaos Test Orchestration
# ------------------------------------------------------------------------------
# Toggle live Triton execution during benchmark sweeps (0 = mock dry-run, 1 = live Triton gRPC)
LIVE_TRITON=0

# Target endpoint for online latency profiler benchmark (test_online_latency_profiler.py)
TRITON_ONLINE_GRPC_TARGET=localhost:8001

# Target endpoint for single-node batch sweep benchmark (test_single_node_embedding_sweep.py)
TRITON_BATCH_GRPC_TARGET=localhost:8001

# Comma-separated cluster endpoints for multi-node ingestion scaling (test_multi_node_ingestion_scaling.py)
TRITON_CLUSTER_ENDPOINTS=localhost:8001
