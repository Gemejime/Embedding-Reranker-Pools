name: "online_embedder_ensemble"
platform: "ensemble"
max_batch_size: 32

input [
  {
    name: "raw_text"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "embeddings"
    data_type: TYPE_FP16
    dims: [ 768 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "text_tokenizer"
      model_version: -1
      input_map {
        key: "raw_text"
        value: "raw_text"
      }
      output_map {
        key: "input_ids"
        value: "token_ids"
      }
      output_map {
        key: "attention_mask"
        value: "attn_mask"
      }
    },
    {
      model_name: "dense_embedder_trt"
      model_version: -1
      input_map {
        key: "input_ids"
        value: "token_ids"
      }
      input_map {
        key: "attention_mask"
        value: "attn_mask"
      }
      output_map {
        key: "embeddings"
        value: "embeddings"
      }
    }
  ]
}
