name: "online_reranker_ensemble"
platform: "ensemble"
max_batch_size: 32

input [
  {
    name: "query"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "passage"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP16
    dims: [ 1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "text_tokenizer"
      model_version: -1
      input_map {
        key: "query"
        value: "query"
      }
      input_map {
        key: "passage"
        value: "passage"
      }
      output_map {
        key: "input_ids"
        value: "token_ids"
      }
      output_map {
        key: "attention_mask"
        value: "attn_mask"
      }
    },
    {
      model_name: "cross_encoder_trt"
      model_version: -1
      input_map {
        key: "input_ids"
        value: "token_ids"
      }
      input_map {
        key: "attention_mask"
        value: "attn_mask"
      }
      output_map {
        key: "logits"
        value: "logits"
      }
    }
  ]
}
